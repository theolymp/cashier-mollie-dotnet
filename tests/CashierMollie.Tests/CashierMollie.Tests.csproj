<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA1816;CA1859</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- Not called from any test. It arrives transitively with the SQL Server provider, which
         resolves it to 9.0.4: two denial-of-service advisories apply there, GHSA-846f-f764-76mx
         (high, CVE-2026-84008) and GHSA-2fmv-rv2c-59x7 (moderate, CVE-2026-70162).
         NuGetAuditMode=all plus TreatWarningsAsErrors turns that into a restore error, so adding
         the provider without this line does not fail a scan later; it fails the restore at once.
         10.0.13 is the first patched version of this band, measured from the advisories rather
         than assumed. Since 2026-11-12 it sits on 10.0.15 with the rest of the 10.0 references.
         Remove the line once the provider's own dependency has moved past it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CashierMollie\CashierMollie.csproj" />
  </ItemGroup>

</Project>