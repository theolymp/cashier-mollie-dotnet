<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Example consumer of CashierMollie and the script for the Mollie test-mode run.
       Not packed, not published: it references the library source so it always builds
       against main. A real application references the NuGet package instead. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UserSecretsId>cashiermollie-sample</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CashierMollie\CashierMollie.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
  </ItemGroup>

</Project>
