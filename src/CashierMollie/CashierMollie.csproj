<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Metadata -->
    <PackageId>CashierMollie</PackageId>
    <Version>0.1.0</Version>
    <Authors>TheOlymp</Authors>
    <Description>Mollie subscription management for ASP.NET Core — feature parity with laravel/cashier-mollie</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TheOlymp/cashier-mollie-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheOlymp/cashier-mollie-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mollie;payments;subscriptions;billing;cashier;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.3" />
    <PackageReference Include="Mollie.Api" Version="4.18.0" />
  </ItemGroup>

</Project>
