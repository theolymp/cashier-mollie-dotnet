<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both, not the newer one alone: a library that drops net10.0 forces every consumer onto
         net11.0 at once, and net10.0 is supported for as long as net11.0 is (both end
         2028-11-14). Money is identical across the two: src/ holds no floating point, which is
         the one place net11.0 changed arithmetic ((decimal)double became exact):
         Architecture/NoFloatingPointTests keeps it that way, MollieAmountWireFormatTests pins the
         rounding on both. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet Package Metadata -->
    <PackageId>CashierMollie</PackageId>
    <!-- The version a tag would publish. Nothing is published by a push: the publish job is
         gated on refs/tags/v*, so this sits here until a tag is cut. -->
    <Version>0.5.0</Version>
    <!-- The rights holder, named the same way in LICENSE, in the packed README and in the
         assembly: Authors is what nuget.org shows, Copyright is what the nuspec carries (it
         had no copyright element at all before 2026-11-07, so this field was empty rather
         than wrong), and Company is where a consumer inspecting the DLL reads it. 0.3.0 and
         0.4.0 are already published and immutable; this takes effect from 0.5.0 on. -->
    <Authors>the Olymp (Robin Parker)</Authors>
    <Copyright>Copyright (c) 2026 the Olymp (Robin Parker)</Copyright>
    <Company>the Olymp (Robin Parker)</Company>
    <Description>Mollie subscription management for ASP.NET Core — feature parity with laravel/cashier-mollie</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TheOlymp/cashier-mollie-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheOlymp/cashier-mollie-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mollie;payments;subscriptions;billing;cashier;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Mollie.Api" Version="4.20.0" />
  </ItemGroup>

</Project>
